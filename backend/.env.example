# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# Database (SQLite for development, PostgreSQL for production)
# For local development, you can leave this commented out (uses SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/crop_disease_db
# For Supabase:
# DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-this

# Optional: ML Model path (defaults to ml_models/crop_disease_model.h5)
# ML_MODEL_PATH=/path/to/your/model.h5
